{
  "title": "ClimaPrev — operação técnica",
  "uid": "climaprev-operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "__inputs": [{ "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus" }],
  "panels": [
    { "id": 1, "title": "Consultas por segundo", "type": "timeseries", "datasource": "${DS_PROMETHEUS}", "gridPos": {"x":0,"y":0,"w":12,"h":8}, "targets": [{"refId":"A","expr":"sum(rate(climaprev_http_requests_total{route=\"/api/v1/risk\"}[5m]))"}] },
    { "id": 2, "title": "Latência global HTTP p95 (s)", "type": "timeseries", "datasource": "${DS_PROMETHEUS}", "gridPos": {"x":12,"y":0,"w":12,"h":8}, "targets": [{"refId":"A","expr":"histogram_quantile(0.95,sum by(le)(rate(climaprev_http_request_duration_seconds_bucket[5m])))"}] },
    { "id": 3, "title": "Respostas por status", "type": "timeseries", "datasource": "${DS_PROMETHEUS}", "gridPos": {"x":0,"y":8,"w":12,"h":8}, "targets": [{"refId":"A","expr":"sum by(status)(rate(climaprev_http_requests_total{route=\"/api/v1/risk\"}[5m]))","legendFormat":"{{status}}"}] },
    { "id": 4, "title": "Disponibilidade de avisos oficiais", "type": "timeseries", "datasource": "${DS_PROMETHEUS}", "gridPos": {"x":12,"y":8,"w":12,"h":8}, "targets": [{"refId":"A","expr":"sum by(status)(rate(climaprev_official_alert_checks_total[5m]))","legendFormat":"{{status}}"}] }
  ]
}
