# Copie este arquivo para .env e ajuste os valores do ambiente local.
# Nunca coloque senhas, tokens ou certificados reais neste arquivo versionado.

# Aplicação
# O backend direto não lê .env automaticamente; exporte os campos necessários.
# Compose injeta apenas os campos declarados no serviço.
# Use REDIS_URL ou CLIMAPREV_REDIS_URL; se ambos existirem, devem ser iguais.
# URL/namespace de cache não são senhas. IPs internos não são autenticadores.
REDIS_URL=redis://redis:6379/0
# Valores aceitos: development, test, load, production.
CLIMAPREV_ENVIRONMENT=development
CLIMAPREV_CORS_ALLOW_ORIGINS=
CLIMAPREV_QUERY_TOTAL_TIMEOUT_SECONDS=7
CLIMAPREV_METRICS_AGGREGATION_ENABLED=false
CLIMAPREV_TRUSTED_PROXY_IPS=172.32.0.10
# Hosts sem scheme/porta. Em production a lista explícita é obrigatória, sem '*'.
CLIMAPREV_ALLOWED_HOSTS=localhost,127.0.0.1,app

# Provedores externos
CLIMAPREV_PROVIDER_ALLOWED_HOSTS=api.open-meteo.com,geocoding-api.open-meteo.com,apiprevmet3.inmet.gov.br
CLIMAPREV_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com
CLIMAPREV_FORECAST_BASE_URL=https://api.open-meteo.com
CLIMAPREV_INMET_ALERTS_BASE_URL=https://apiprevmet3.inmet.gov.br

# Limites e resiliência
CLIMAPREV_RATE_LIMIT=60
CLIMAPREV_RATE_LIMIT_BURST=10
CLIMAPREV_RATE_LIMIT_WINDOW_SECONDS=60
CLIMAPREV_CONNECT_TIMEOUT_SECONDS=2.0
CLIMAPREV_READ_TIMEOUT_SECONDS=5.0
# Bytes descomprimidos (teto 64 MiB); deadline total com retries (teto 60 s).
CLIMAPREV_PROVIDER_MAX_RESPONSE_BYTES=5242880
CLIMAPREV_PROVIDER_TOTAL_TIMEOUT_SECONDS=20
CLIMAPREV_HTTP_MAX_CONNECTIONS=20
CLIMAPREV_HTTP_MAX_KEEPALIVE_CONNECTIONS=10
CLIMAPREV_REDIS_SOCKET_TIMEOUT_SECONDS=1.0
CLIMAPREV_ADDITIONAL_RETRIES=2
CLIMAPREV_PROVIDER_BUDGET_CAPACITY=60
CLIMAPREV_PROVIDER_BUDGET_REFILL=60
CLIMAPREV_PROVIDER_BUDGET_WINDOW_SECONDS=60

# Perfil de carga local
CLIMAPREV_LOAD_SCENARIO=warm_cache
CLIMAPREV_LOAD_REQUESTS_PER_SECOND_PER_USER=1
CLIMAPREV_LOAD_RATE_LIMIT=100000
CLIMAPREV_LOAD_RATE_LIMIT_BURST=100000
CLIMAPREV_LOAD_PROVIDER_BUDGET_CAPACITY=100000
CLIMAPREV_LOAD_PROVIDER_BUDGET_REFILL=100000
CLIMAPREV_LOAD_PROVIDER_BUDGET_WINDOW_SECONDS=60
CLIMAPREV_PROVIDER_MOCK_DELAY_MS=150
CLIMAPREV_LOAD_REDIS_OPERATION_DELAY_MS=50

# Rede local
CLIMAPREV_FRONTEND_IP=172.32.0.10
CLIMAPREV_LOCAL_SUBNET=172.32.0.0/24
CLIMAPREV_BACKEND_SUBNET=172.31.0.0/24

# Homologação: configure fora do Git, preferencialmente em .homolog/compose.env.
# CLIMAPREV_HOMOLOG_DIR=.homolog
# CLIMAPREV_HOMOLOG_PORT=18443
# CLIMAPREV_PROXY_IP=10.253.248.2
# CLIMAPREV_APP_IP=10.253.248.3
# CLIMAPREV_INGRESS_SUBNET=10.253.248.0/24
# CLIMAPREV_REDIS_PASSWORD_FILE=/run/secrets/redis_password
# CLIMAPREV_CLIENT_IP_HMAC_KEY_FILE=/run/secrets/client_ip_hmac_key
# Production exige ambos os arquivos: senha Redis e HMAC independente de 32 bytes
# (64 caracteres hex). Gere fora do Git; monte apenas no app. Não use senha em
# URL, variável literal, frontend ou build. Os perfis locais sem esses arquivos
# são destinados somente a testes isolados com dados sintéticos.
